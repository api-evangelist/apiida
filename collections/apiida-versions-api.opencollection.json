{
  "opencollection": "1.0.0",
  "info": {
    "name": "APIIDA API Control Plane Alarms Versions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Versions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "APIIDA Create API Version",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.backend.apiida.io/apis/:apiId/versions",
            "params": [
              {
                "name": "apiId",
                "value": "",
                "type": "path",
                "description": "The API identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new version for an existing API in the control plane."
        },
        {
          "info": {
            "name": "APIIDA Upload Specification to API Version",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{tenant}.backend.apiida.io/apis/:apiId/versions/:version/openProxySpec",
            "params": [
              {
                "name": "apiId",
                "value": "",
                "type": "path",
                "description": "The API identifier"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "The API version identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upload an Open Proxy Specification to a specific API version."
        }
      ]
    }
  ],
  "bundled": true
}